{
  "name": "microcms-extension-2fa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "dev": "node --watch --watch-path=src --watch-path=public --watch-path=tsconfig.json --watch-path=scripts/build.ts scripts/dev.ts",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js",
    "pretest:browser": "npm run build",
    "test:browser": "node dist/scripts/browser-smoke.js"
  },
  "dependencies": {
    "microcms-field-extension-api": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
